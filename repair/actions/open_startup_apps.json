{
  "id": "open_startup_apps",
  "name": "启动应用",
  "level": "green",
  "launcher": true,
  "common": true,
  "desc": "开机自启的开与关都在这里。",
  "affect": "只打开窗口，不改任何设置、不点任何按钮。",
  "undo": "关掉打开的窗口即恢复原状，无需回滚。",
  "requires_admin": false,
  "prechecks": [],
  "steps": [
    {
      "exe": "cmd.exe",
      "args": [
        "/c",
        "start",
        "ms-settings:startupapps"
      ],
      "desc": "打开「启动应用（开机自启）」窗口",
      "display": "start ms-settings:startupapps"
    }
  ],
  "rollback": [],
  "rollback_note": "只开窗，无需回滚",
  "timeout_sec": 15,
  "caveat": "",
  "match_checks": [],
  "verify_checks": [],
  "sources": [
    {
      "title": "ms-settings URI 官方参考（启动任意设置页，微软 Learn）",
      "url": "https://learn.microsoft.com/en-us/windows/apps/develop/launch/launch-settings"
    },
    {
      "title": "Win32_StartupCommand 官方类文档（微软 Learn）",
      "url": "https://learn.microsoft.com/en-us/windows/win32/cimwin32prov/win32-startupcommand"
    }
  ]

{
  "id": "open_devmgr",
  "name": "设备管理器",
  "level": "green",
  "launcher": true,
  "common": true,
  "desc": "看设备黄三角、卸载残留设备、更新驱动。",
  "affect": "只打开窗口，不改任何设置、不点任何按钮。",
  "undo": "关掉打开的窗口即恢复原状，无需回滚。",
  "requires_admin": false,
  "prechecks": [],
  "steps": [
    {
      "exe": "cmd.exe",

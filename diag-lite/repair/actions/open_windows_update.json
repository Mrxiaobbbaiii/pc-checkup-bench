{
  "id": "open_windows_update",
  "name": "Windows 更新",
  "level": "green",
  "launcher": true,
  "common": true,
  "desc": "检查更新、看更新历史。",
  "affect": "只打开窗口，不改任何设置、不点任何按钮。",
  "undo": "关掉打开的窗口即恢复原状，无需回滚。",
  "requires_admin": false,
  "prechecks": [],
